# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

project_id = "my-calendar-bot-project"
region     = "us-central1"

# --- Telegram -------------------------------------------------------------
# From @BotFather
telegram_bot_token = "1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
# Any random string, 16-256 chars of [A-Za-z0-9_-].
#   openssl rand -hex 32
telegram_webhook_secret = "replace-me-with-a-long-random-string"
# From @userinfobot
allowed_telegram_user_id = "123456789"

# --- LLM ------------------------------------------------------------------
llm_api_key = "sk-..."
# Swapping providers is these three settings and nothing else.
llm_base_url = "https://api.deepseek.com/v1"
llm_model    = "deepseek-v4-flash"

# --- Calendar -------------------------------------------------------------
# Your real calendar id (usually your email address), NOT "primary".
calendar_id = "you@gmail.com"
timezone    = "America/New_York"

# --- Cost guardrails ------------------------------------------------------
# Creates a $1/month budget alert. Find the id with:
#   gcloud billing accounts list
# Leave empty to skip it (needs permission on the billing account, which is
# separate from project Owner).
billing_account_id = ""

